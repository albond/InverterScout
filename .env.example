# Bind to localhost by default. Set this to the Docker host's LAN address only
# when other devices on the same trusted home network must reach the Web UI.
INVERTERSCOUT_BIND_ADDRESS=127.0.0.1
INVERTERSCOUT_WEB_PORT=8080

# The inverter address is intentionally not stored here. The Quick Start
# launcher checks it without saving it, and the browser wizard stores it in the
# encrypted local database.

# Optional advanced mode: provide a Fernet key through a Docker secret or
# environment injection. Never commit an actual key here.
# INVERTERSCOUT_MASTER_KEY=
